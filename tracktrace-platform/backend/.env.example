# Copy to .env for local development. In production, set these as real environment
# variables (Render dashboard, systemd unit, etc.) - never commit a filled-in .env.

ENVIRONMENT=development

# PostgreSQL - required, no SQLite fallback.
DATABASE_URL=postgresql+psycopg://tnt:tnt_dev_pw@localhost:5432/tnt_dev

# Secrets - generate real random values for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-not-for-production
JWT_SECRET=dev-secret-not-for-production
ACCESS_TOKEN_MINUTES=480
PASSWORD_RESET_MINUTES=30

# URLs / CORS / cookies
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Set true only when running behind Render/Cloudflare so client-ip rate limiting reads the real IP.
TRUSTED_PROXY_HEADERS=false

# Business defaults (also editable at runtime via /api/admin/settings)
TRACKING_PREFIX=NWT

# Rate limits: "count/seconds"
RATE_LIMIT_TRACKING=30/60
RATE_LIMIT_LOGIN=10/300
RATE_LIMIT_REGISTER=10/3600
RATE_LIMIT_FORGOT=5/3600
RATE_LIMIT_FORMS=10/3600
ACCOUNT_LOCK_THRESHOLD=8
ACCOUNT_LOCK_MINUTES=15

# Email (SMTP) - leave blank to disable; emails are then logged, never faked as sent
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# SMS + WhatsApp (Twilio-compatible) - leave blank to disable
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Document storage
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads_dev
MAX_UPLOAD_MB=10
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
